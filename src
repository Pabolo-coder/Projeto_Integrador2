<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EcoLastro CTBJ</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root {
    --paper: #F6F1E3;
    --paper-card: #EFE6CF;
    --paper-card-2: #E7DBBC;
    --ink: #23301F;
    --ink-soft: #4C5A45;
    --forest: #2E4B30;
    --forest-dark: #1D3320;
    --forest-tint: #DCE6D3;
    --rust: #BE6430;
    --rust-tint: #F1DAC6;
    --mustard: #D89B34;
    --mustard-tint: #F4E3BE;
    --line: rgba(35, 48, 31, 0.16);
    --danger: #A8432B;
    --danger-tint: #F3DCD3;
    --shadow: 0 1px 0 rgba(35,48,31,0.06);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --paper: #16201A;
      --paper-card: #1E2B22;
      --paper-card-2: #263426;
      --ink: #EAE6D8;
      --ink-soft: #B7C2AE;
      --forest: #7FAE7F;
      --forest-dark: #A6CBA1;
      --forest-tint: #26382A;
      --rust: #E2925C;
      --rust-tint: #3A2A22;
      --mustard: #E8BE6E;
      --mustard-tint: #3A3323;
      --line: rgba(234,230,216,0.14);
      --danger-tint: #3A2622;
      --shadow: 0 1px 0 rgba(0,0,0,0.2);
    }
  }
  :root[data-theme="dark"] {
    --paper: #16201A;
    --paper-card: #1E2B22;
    --paper-card-2: #263426;
    --ink: #EAE6D8;
    --ink-soft: #B7C2AE;
    --forest: #7FAE7F;
    --forest-dark: #A6CBA1;
    --forest-tint: #26382A;
    --rust: #E2925C;
    --rust-tint: #3A2A22;
    --mustard: #E8BE6E;
    --mustard-tint: #3A3323;
    --line: rgba(234,230,216,0.14);
    --danger-tint: #3A2622;
    --shadow: 0 1px 0 rgba(0,0,0,0.2);
  }

  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: var(--paper);
    color: var(--ink);
    font-family: 'IBM Plex Sans', sans-serif;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, .display {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0;
  }
  button { font-family: inherit; cursor: pointer; }
  input, select { font-family: inherit; }
  a { color: inherit; }
  .mono { font-family: 'IBM Plex Mono', monospace; }

  .app { min-height: 100vh; }
  .hidden { display: none !important; }

  /* ---------- Offline banner (RNF02) ---------- */
  #offline-banner {
    display: none;
    position: sticky; top: 0; z-index: 50;
    background: var(--danger); color: #FBEDE6;
    text-align: center; font-size: 13px; font-weight: 600;
    padding: 8px 12px;
  }
  #offline-banner.show { display: block; }

  /* ---------- Auth screen ---------- */
  #view-auth {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
  }
  .auth-shell {
    width: 100%;
    max-width: 940px;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    background: var(--paper-card);
    border: 1px solid var(--line);
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 24px 60px -30px rgba(23,32,19,0.35);
  }
  @media (max-width: 760px) {
    .auth-shell { grid-template-columns: 1fr; }
    .auth-side { display: none; }
  }
  .auth-side {
    background:
      radial-gradient(120% 140% at 15% 10%, rgba(255,255,255,0.12), transparent 45%),
      linear-gradient(165deg, var(--forest) 0%, var(--forest-dark) 100%);
    color: #F3EEDC;
    padding: 44px 38px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .auth-mark { display: flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 600; }
  .auth-mark .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--mustard); }
  .auth-side h1 { color: #F3EEDC; font-size: 33px; line-height: 1.15; margin-top: 26px; }
  .auth-side p.sub { color: rgba(243,238,220,0.78); font-size: 14.5px; line-height: 1.6; margin-top: 14px; max-width: 34ch; }
  .chain {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 30px;
    flex-wrap: wrap;
  }
  .chain span {
    font-size: 12.5px;
    padding: 6px 11px;
    border-radius: 100px;
    background: rgba(243,238,220,0.12);
    border: 1px solid rgba(243,238,220,0.22);
  }
  .chain .arrow { color: rgba(243,238,220,0.5); font-size: 13px; }
  .auth-quote {
    font-size: 13px;
    color: rgba(243,238,220,0.65);
    border-top: 1px solid rgba(243,238,220,0.18);
    padding-top: 14px;
    line-height: 1.55;
  }

  .auth-form-wrap { padding: 36px 40px; display: flex; flex-direction: column; max-height: 100vh; overflow-y: auto; }
  .tabs { display: flex; gap: 4px; background: var(--paper-card-2); padding: 4px; border-radius: 12px; margin-bottom: 22px; }
  .tab-btn {
    flex: 1; border: none; background: transparent; padding: 9px 12px;
    border-radius: 9px; font-size: 14px; font-weight: 600; color: var(--ink-soft);
    transition: background .15s ease, color .15s ease;
  }
  .tab-btn.active { background: var(--paper); color: var(--forest-dark); box-shadow: var(--shadow); }

  .field { margin-bottom: 14px; }
  .field label { display: block; font-size: 12.5px; font-weight: 600; color: var(--ink-soft); margin-bottom: 6px; }
  .field input, .field select {
    width: 100%; padding: 11px 13px; border-radius: 10px;
    border: 1px solid var(--line); background: var(--paper);
    color: var(--ink); font-size: 14.5px;
  }
  .field input:focus, .field select:focus, button:focus-visible, .tab-btn:focus-visible, .navlink:focus-visible {
    outline: 2px solid var(--forest-dark); outline-offset: 2px;
  }
  .pw-wrap { position: relative; }
  .pw-wrap input { padding-right: 66px; }
  .pw-toggle {
    position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
    background: transparent; border: none; font-size: 11.5px; font-weight: 700;
    color: var(--forest-dark); padding: 6px 8px;
  }
  .field-hint { font-size: 11.5px; color: var(--ink-soft); margin-top: 5px; }
  .profile-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .profile-opt {
    border: 1px solid var(--line); background: var(--paper); border-radius: 10px;
    padding: 10px 6px; text-align: center; font-size: 12.5px; font-weight: 600; color: var(--ink-soft);
  }
  .profile-opt.selected { border-color: var(--forest); background: var(--forest-tint); color: var(--forest-dark); }

  .btn-primary {
    width: 100%; padding: 12px; border: none; border-radius: 10px;
    background: var(--forest); color: #F3EEDC; font-weight: 700; font-size: 14.5px;
    margin-top: 6px;
  }
  .btn-primary:hover { background: var(--forest-dark); }
  .form-note { font-size: 12.5px; color: var(--ink-soft); margin-top: 12px; text-align: center; }
  .form-error { font-size: 12.5px; color: var(--danger); margin: -6px 0 12px; min-height: 1em; }
  .security-note {
    display: flex; gap: 8px; align-items: flex-start; margin-top: 16px;
    padding: 10px 12px; background: var(--paper-card-2); border-radius: 10px;
    font-size: 11.5px; color: var(--ink-soft); line-height: 1.5;
  }

  /* ---------- App shell ---------- */
  #view-app { display: none; min-height: 100vh; grid-template-columns: 240px 1fr; }
  #view-app.show { display: grid; }
  @media (max-width: 900px) {
    #view-app.show { grid-template-columns: 1fr; }
    .sidebar { position: sticky; top: 0; z-index: 5; }
  }
  .sidebar {
    background: var(--paper-card);
    border-right: 1px solid var(--line);
    padding: 22px 16px;
    display: flex; flex-direction: column;
  }
  @media (max-width: 900px) {
    .sidebar { border-right: none; border-bottom: 1px solid var(--line); flex-direction: row; align-items: center; gap: 14px; padding: 14px 16px; overflow-x: auto; }
    .sidebar .brand { margin-bottom: 0; }
    .side-nav { flex-direction: row; margin-top: 0; }
    .sidebar .side-foot { display: none; }
  }
  .brand { display: flex; align-items: center; gap: 9px; margin-bottom: 24px; padding: 0 6px; }
  .brand .mark { width: 30px; height: 30px; border-radius: 8px; background: var(--forest); display: grid; place-items: center; font-size: 15px; flex-shrink: 0; }
  .brand .name { font-family: 'Fraunces', serif; font-weight: 600; font-size: 16px; }
  .brand .sub { font-size: 10.5px; color: var(--ink-soft); }

  .side-nav { display: flex; flex-direction: column; gap: 2px; }
  .navlink {
    display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 10px;
    border: none; background: transparent; color: var(--ink-soft); font-size: 13.5px; font-weight: 600;
    text-align: left; white-space: nowrap;
  }
  .navlink:hover { background: var(--paper-card-2); color: var(--ink); }
  .navlink.active { background: var(--forest-tint); color: var(--forest-dark); }
  .navlink .ico { font-size: 15px; width: 18px; text-align: center; }

  .side-foot { margin-top: auto; padding-top: 14px; border-top: 1px solid var(--line); }
  .who { font-size: 12.5px; color: var(--ink-soft); padding: 0 6px; margin-bottom: 10px; line-height: 1.5; }
  .who b { color: var(--ink); display: block; font-size: 13.5px; }
  .btn-ghost {
    width: 100%; padding: 9px; border-radius: 9px; border: 1px solid var(--line);
    background: transparent; color: var(--ink-soft); font-size: 13px; font-weight: 600;
  }
  .btn-ghost:hover { border-color: var(--rust); color: var(--rust); }

  .main { padding: 28px 34px 60px; max-width: 1100px; }
  @media (max-width: 600px) { .main { padding: 20px 16px 48px; } }
  .page { display: none; }
  .page.active { display: block; }
  .page-head { margin-bottom: 22px; }
  .page-head .eyebrow { font-size: 12.5px; color: var(--rust); font-weight: 700; }
  .page-head h2 { font-size: 26px; margin-top: 4px; }
  .page-head p { color: var(--ink-soft); font-size: 14.5px; margin-top: 6px; max-width: 62ch; line-height: 1.55; }

  .card {
    background: var(--paper-card); border: 1px solid var(--line); border-radius: 16px;
  }

  /* ---------- Registro de coleta (RF02) ---------- */
  .coleta-grid { display: grid; grid-template-columns: 1fr 300px; gap: 20px; align-items: start; }
  @media (max-width: 820px) { .coleta-grid { grid-template-columns: 1fr; } }
  .coleta-form { padding: 24px; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  @media (max-width: 480px) { .two-col { grid-template-columns: 1fr; } }
  .geo-row { display: flex; gap: 10px; align-items: center; margin-bottom: 6px; flex-wrap: wrap; }
  .btn-geo {
    padding: 9px 13px; border-radius: 9px; border: 1px solid var(--forest);
    background: var(--forest-tint); color: var(--forest-dark); font-weight: 700; font-size: 13px;
  }
  .btn-geo:hover { background: var(--forest); color: #F3EEDC; }
  .geo-status { font-size: 12px; color: var(--ink-soft); }
  .readonly-field { background: var(--paper-card-2) !important; color: var(--ink-soft) !important; }
  .tip-card { padding: 20px; }
  .tip-card h3 { font-size: 14.5px; margin-bottom: 10px; }
  .tip-card ol { margin: 0; padding-left: 18px; font-size: 13px; color: var(--ink-soft); line-height: 1.9; }
  .tip-card .qr-mini { margin-top: 16px; padding: 14px; background: var(--paper-card-2); border-radius: 12px; font-size: 12px; color: var(--ink-soft); line-height: 1.6; }

  /* ---------- Rastreamento ---------- */
  .lote-list { display: flex; flex-direction: column; gap: 14px; }
  .lote-card { padding: 18px 20px; }
  .lote-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
  .lote-id { font-size: 12px; color: var(--ink-soft); font-weight: 600; }
  .lote-title { font-size: 17px; font-weight: 700; margin-top: 2px; }
  .lote-meta { font-size: 13px; color: var(--ink-soft); margin-top: 3px; }
  .lote-badges { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .lote-tag {
    font-size: 11.5px; font-weight: 700; padding: 5px 10px; border-radius: 100px;
    background: var(--mustard-tint); color: #7A5417;
    white-space: nowrap;
  }
  .btn-qr {
    font-size: 11.5px; font-weight: 700; padding: 5px 10px; border-radius: 100px;
    background: transparent; border: 1px solid var(--line); color: var(--ink-soft);
  }
  .btn-qr:hover { border-color: var(--forest); color: var(--forest-dark); }
  .stages { display: flex; align-items: center; margin-top: 18px; }
  .stage { flex: 1; display: flex; flex-direction: column; align-items: center; position: relative; }
  .stage .pt { width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--line); background: var(--paper); display: grid; place-items: center; font-size: 12px; font-weight: 700; color: var(--ink-soft); z-index: 1; }
  .stage .lbl { font-size: 11.5px; color: var(--ink-soft); margin-top: 8px; font-weight: 600; text-align: center; }
  .stage .bar { position: absolute; top: 13px; left: 50%; width: 100%; height: 2px; background: var(--line); z-index: 0; }
  .stage:first-child .bar { display: none; }
  .stage.done .pt { background: var(--forest); border-color: var(--forest); color: #F3EEDC; }
  .stage.done .lbl { color: var(--forest-dark); }
  .stage.done .bar { background: var(--forest); }
  .stage.current .pt { background: var(--paper); border-color: var(--rust); color: var(--rust); box-shadow: 0 0 0 4px var(--rust-tint); }
  .stage.current .lbl { color: var(--rust); }
  .lote-foot { margin-top: 14px; font-size: 12.5px; color: var(--ink-soft); display: flex; gap: 6px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .lote-foot b { color: var(--ink); font-weight: 600; }
  .geo-tag { font-size: 11.5px; color: var(--ink-soft); }

  .filter-row { display: flex; gap: 8px; margin-bottom: 18px; flex-wrap: wrap; }
  .chip {
    padding: 7px 13px; border-radius: 100px; border: 1px solid var(--line);
    background: var(--paper-card); font-size: 13px; font-weight: 600; color: var(--ink-soft);
  }
  .chip.active { background: var(--forest); border-color: var(--forest); color: #F3EEDC; }

  .load-more-wrap { display: flex; justify-content: center; margin-top: 18px; }
  .btn-loadmore {
    padding: 10px 20px; border-radius: 100px; border: 1px solid var(--forest);
    background: transparent; color: var(--forest-dark); font-weight: 700; font-size: 13px;
  }
  .btn-loadmore:hover { background: var(--forest); color: #F3EEDC; }

  /* Marketplace */
  .mk-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .mk-card { padding: 18px; display: flex; flex-direction: column; }
  .mk-icon { width: 40px; height: 40px; border-radius: 10px; background: var(--forest-tint); display: grid; place-items: center; font-size: 19px; margin-bottom: 12px; }
  .mk-mat { font-size: 15.5px; font-weight: 700; }
  .mk-coop { font-size: 12.5px; color: var(--ink-soft); margin-top: 2px; }
  .mk-stats { display: flex; justify-content: space-between; margin-top: 14px; padding-top: 14px; border-top: 1px dashed var(--line); font-size: 13px; }
  .mk-stats div b { display: block; font-size: 15px; color: var(--ink); }
  .mk-stats div span { color: var(--ink-soft); font-size: 11.5px; }
  .btn-mk {
    margin-top: 14px; padding: 10px; border-radius: 9px; border: 1px solid var(--forest);
    background: transparent; color: var(--forest-dark); font-weight: 700; font-size: 13.5px;
  }
  .btn-mk:hover { background: var(--forest); color: #F3EEDC; }
  .btn-mk.requested { background: var(--forest-tint); border-color: var(--forest-tint); color: var(--forest-dark); cursor: default; }

  /* Pontuação (RF08) */
  .score-hero { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 22px; }
  @media (max-width: 700px) { .score-hero { grid-template-columns: 1fr; } }
  .score-card { padding: 22px; }
  .score-card .n { font-family: 'Fraunces', serif; font-size: 34px; font-weight: 600; color: var(--forest-dark); }
  .score-card .lbl { font-size: 12.5px; color: var(--ink-soft); margin-top: 4px; }
  .level-track { margin-top: 14px; }
  .level-bar { height: 8px; background: var(--paper-card-2); border-radius: 100px; overflow: hidden; }
  .level-fill { height: 100%; background: linear-gradient(90deg, var(--mustard), var(--forest)); }
  .level-lbl { font-size: 11.5px; color: var(--ink-soft); margin-top: 6px; display: flex; justify-content: space-between; }

  table.rank { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  table.rank th { text-align: left; font-size: 11.5px; text-transform: none; color: var(--ink-soft); padding: 0 10px 10px; border-bottom: 1px solid var(--line); font-weight: 600; }
  table.rank td { padding: 11px 10px; border-bottom: 1px solid var(--line); }
  table.rank tr:last-child td { border-bottom: none; }
  table.rank .pos { font-weight: 700; color: var(--ink-soft); width: 28px; }
  table.rank .me { background: var(--forest-tint); }
  .pts-pill { font-weight: 700; color: var(--forest-dark); }

  .reward-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; margin-top: 16px; }
  .reward-card { padding: 16px; text-align: left; }
  .reward-card .ic { font-size: 22px; }
  .reward-card .rn { font-weight: 700; font-size: 14.5px; margin-top: 8px; }
  .reward-card .rc { font-size: 12.5px; color: var(--ink-soft); margin-top: 3px; }
  .btn-redeem { margin-top: 12px; width: 100%; padding: 9px; border-radius: 9px; border: 1px solid var(--rust); background: transparent; color: var(--rust); font-weight: 700; font-size: 13px; }
  .btn-redeem:hover:not(:disabled) { background: var(--rust); color: #FBEDE6; }
  .btn-redeem:disabled { opacity: .45; cursor: not-allowed; border-color: var(--line); color: var(--ink-soft); }

  /* Impacto */
  .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 26px; }
  @media (max-width: 760px) { .stat-grid { grid-template-columns: repeat(2, 1fr); } }
  .stat-card { padding: 18px; }
  .stat-card .n { font-family: 'Fraunces', serif; font-size: 28px; font-weight: 600; color: var(--forest-dark); }
  .stat-card .lbl { font-size: 12.5px; color: var(--ink-soft); margin-top: 4px; }
  .panel { padding: 22px; margin-bottom: 20px; }
  .panel h3 { font-size: 15.5px; margin-bottom: 16px; }
  .bar-row { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .bar-row .bl { width: 88px; font-size: 13px; color: var(--ink-soft); flex-shrink: 0; }
  .bar-track { flex: 1; height: 10px; background: var(--paper-card-2); border-radius: 100px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 100px; background: var(--forest); }
  .bar-row .bv { width: 56px; text-align: right; font-size: 12.5px; font-weight: 700; color: var(--ink); flex-shrink: 0; }
  .impact-note { font-size: 12.5px; color: var(--ink-soft); line-height: 1.6; }
  .arch-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  @media (max-width: 760px) { .arch-grid { grid-template-columns: repeat(2, 1fr); } }
  .arch-item { padding: 12px; background: var(--paper-card-2); border-radius: 10px; font-size: 12px; color: var(--ink-soft); }
  .arch-item b { display: block; color: var(--ink); font-size: 13px; margin-bottom: 2px; }

  /* Modal QR (RF03) */
  .modal-overlay {
    position: fixed; inset: 0; background: rgba(22,32,26,0.55);
    display: none; align-items: center; justify-content: center; z-index: 100; padding: 20px;
  }
  .modal-overlay.show { display: flex; }
  .modal-box {
    background: var(--paper); border-radius: 18px; padding: 26px;
    max-width: 340px; width: 100%; text-align: center; position: relative;
  }
  .modal-close { position: absolute; top: 12px; right: 12px; border: none; background: transparent; font-size: 16px; color: var(--ink-soft); padding: 6px; }
  .modal-box h3 { font-size: 16px; margin-bottom: 4px; }
  .modal-box .sub { font-size: 12.5px; color: var(--ink-soft); margin-bottom: 16px; }
  #qr-render { display: flex; justify-content: center; padding: 12px; background: #fff; border-radius: 12px; min-height: 160px; align-items: center; }
  .qr-fallback { font-size: 11px; text-align: left; background: var(--paper-card-2); padding: 10px; border-radius: 8px; word-break: break-all; color: var(--ink-soft); }
  .qr-info { margin-top: 14px; font-size: 12.5px; color: var(--ink-soft); text-align: left; background: var(--paper-card); border: 1px solid var(--line); border-radius: 10px; padding: 12px; line-height: 1.7; }
  .qr-info b { color: var(--ink); }
</style>
