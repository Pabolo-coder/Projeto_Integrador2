<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.0.3/qrcode.min.js"></script>
<script>
  // ---------------- Estado ----------------
  const STAGES = ['Coleta', 'Triagem', 'Venda', 'Reciclagem'];
  const STORAGE_KEY = 'ecolastro_lotes_v1';
  const REDEEM_KEY = 'ecolastro_resgates_v1';
  const LOTE_PAGE_SIZE = 4;
  const MK_PAGE_SIZE = 3;
  let currentUserName = 'Você';

  const LOTES_DEFAULT = [
    { id: 'LT-014', material: 'Papelão', icon: '📦', kg: 120, resp: 'Maria Silva', tipo: 'Catador', stage: 1, atualizado: 'há 2 dias', lat: '-4.9744', lng: '-42.2378' },
    { id: 'LT-015', material: 'Plástico PET', icon: '🧴', kg: 85, resp: 'João Souza', tipo: 'Catador', stage: 2, atualizado: 'há 1 dia', lat: '-4.9751', lng: '-42.2360' },
    { id: 'LT-016', material: 'Vidro', icon: '🍾', kg: 40, resp: 'Ana Lima', tipo: 'Catador', stage: 0, atualizado: 'hoje', lat: '-4.9739', lng: '-42.2391' },
    { id: 'LT-017', material: 'Metal', icon: '🥫', kg: 60, resp: 'Cooperativa Verde Vida', tipo: 'Cooperativa', stage: 3, atualizado: 'há 4 dias', lat: '-4.9760', lng: '-42.2350' },
    { id: 'LT-018', material: 'Papel branco', icon: '📄', kg: 32, resp: 'Pedro Rocha', tipo: 'Catador', stage: 1, atualizado: 'há 3 dias', lat: '-4.9748', lng: '-42.2382' },
    { id: 'LT-019', material: 'Plástico misto', icon: '🧃', kg: 54, resp: 'Cooperativa Renasce', tipo: 'Cooperativa', stage: 2, atualizado: 'há 6 horas', lat: '-4.9733', lng: '-42.2401' },
  ];

  const CREDITOS_DEFAULT = [
    { material: 'Metal', icon: '🥫', origem: 'Cooperativa Verde Vida', kg: 60, credito: 18 },
    { material: 'Papelão', icon: '📦', origem: 'Cooperativa Renasce', kg: 210, credito: 42 },
    { material: 'Vidro', icon: '🍾', origem: 'Maria Silva', kg: 40, credito: 9 },
    { material: 'Plástico PET', icon: '🧴', origem: 'João Souza', kg: 85, credito: 21 },
    { material: 'Papel branco', icon: '📄', origem: 'Pedro Rocha', kg: 32, credito: 7 },
  ];

  const REWARDS = [
    { icon: '🎫', nome: 'Vale-transporte (1 semana)', custo: 80 },
    { icon: '🧤', nome: 'Kit de EPI (luvas + botas)', custo: 150 },
    { icon: '🥗', nome: 'Cesta básica', custo: 220 },
    { icon: '🏅', nome: 'Certificado de destaque CTBJ', custo: 60 },
  ];

  let LOTES = [];
  let loteVisibleCount = LOTE_PAGE_SIZE;
  let mkVisibleCount = MK_PAGE_SIZE;
  let currentFilter = 'todos';
  let redeemedTotal = 0;

  function loadState() {
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
      LOTES = Array.isArray(saved) && saved.length ? saved : JSON.parse(JSON.stringify(LOTES_DEFAULT));
    } catch (e) {
      LOTES = JSON.parse(JSON.stringify(LOTES_DEFAULT));
    }
    try {
      redeemedTotal = Number(localStorage.getItem(REDEEM_KEY)) || 0;
    } catch (e) { redeemedTotal = 0; }
  }

  function saveLotes() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(LOTES)); } catch (e) { /* modo offline sem storage disponível */ }
  }
  function saveRedeemed() {
    try { localStorage.setItem(REDEEM_KEY, String(redeemedTotal)); } catch (e) { /* ignora */ }
  }

  // ---------------- Offline (RNF02) ----------------
  function updateOnlineStatus() {
    document.getElementById('offline-banner').classList.toggle('show', !navigator.onLine);
  }
  window.addEventListener('online', updateOnlineStatus);
  window.addEventListener('offline', updateOnlineStatus);

  // ---------------- Auth ----------------
  function togglePw(id, btn) {
    const input = document.getElementById(id);
    const isPw = input.type === 'password';
    input.type = isPw ? 'text' : 'password';
    btn.textContent = isPw ? 'ocultar' : 'mostrar';
  }

  function setAuthTab(which) {
    document.getElementById('tab-login').classList.toggle('active', which === 'login');
    document.getElementById('tab-signup').classList.toggle('active', which === 'signup');
    document.getElementById('form-login').classList.toggle('hidden', which !== 'login');
    document.getElementById('form-signup').classList.toggle('hidden', which !== 'signup');
  }

  function pickProfile(btn) {
    document.querySelectorAll('.profile-opt').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
  }

  function doLogin(e) {
    e.preventDefault();
    const email = document.getElementById('login-email').value.trim();
    if (!email) {
      document.getElementById('login-error').textContent = 'Informe um e-mail válido.';
      return false;
    }
    const nome = email.split('@')[0].replace(/[._]/g, ' ');
    enterApp(nome.charAt(0).toUpperCase() + nome.slice(1), 'Perfil: Catador');
    return false;
  }

  function doSignup(e) {
    e.preventDefault();
    const nome = document.getElementById('s-nome').value.trim();
    const senha = document.getElementById('s-senha').value;
    const senha2 = document.getElementById('s-senha2').value;
    if (!nome) {
      document.getElementById('signup-error').textContent = 'Informe seu nome completo.';
      return false;
    }
    if (senha !== senha2) {
      document.getElementById('signup-error').textContent = 'As senhas não coincidem.';
      return false;
    }
    const perfil = document.querySelector('.profile-opt.selected').dataset.val;
    const perfilLabel = { catador: 'Catador', cooperativa: 'Cooperativa', empresa: 'Empresa' }[perfil];
    enterApp(nome, 'Perfil: ' + perfilLabel);
    return false;
  }

  function enterApp(nome, roleLabel) {
    currentUserName = nome;
    document.getElementById('who-name').textContent = nome;
    document.getElementById('who-role').textContent = roleLabel;
    document.getElementById('c-resp').value = nome;
    document.getElementById('view-auth').style.display = 'none';
    document.getElementById('view-app').classList.add('show');
    renderPontuacao();
    goPage('coleta');
  }

  function doLogout() {
    document.getElementById('view-app').classList.remove('show');
    document.getElementById('view-auth').style.display = 'grid';
    document.getElementById('form-login').reset();
    document.getElementById('form-signup').reset();
    document.getElementById('login-error').textContent = '';
    document.getElementById('signup-error').textContent = '';
    setAuthTab('login');
  }

  // ---------------- Navegação ----------------
  function goPage(name) {
    document.querySelectorAll('.navlink').forEach(b => b.classList.toggle('active', b.dataset.page === name));
    document.querySelectorAll('.page').forEach(p => p.classList.toggle('active', p.id === 'page-' + name));
  }

  // ---------------- Registrar coleta (RF02) ----------------
  function usarLocalizacao() {
    const status = document.getElementById('geo-status');
    if (!navigator.geolocation) {
      status.textContent = 'Geolocalização indisponível neste navegador — digite as coordenadas manualmente.';
      return;
    }
    status.textContent = 'Obtendo localização...';
    navigator.geolocation.getCurrentPosition(
      pos => {
        document.getElementById('c-lat').value = pos.coords.latitude.toFixed(5);
        document.getElementById('c-lng').value = pos.coords.longitude.toFixed(5);
        status.textContent = 'Localização capturada com sucesso ✓';
      },
      err => {
        status.textContent = 'Não foi possível obter sua localização (' + err.message + '). Digite manualmente.';
      },
      { timeout: 8000 }
    );
  }

  function registrarColeta(e) {
    e.preventDefault();
    const material = document.getElementById('c-material').value;
    const peso = parseFloat(document.getElementById('c-peso').value);
    const lat = document.getElementById('c-lat').value.trim();
    const lng = document.getElementById('c-lng').value.trim();
    const resp = document.getElementById('c-resp').value || currentUserName;
    const icons = { 'Papelão': '📦', 'Plástico PET': '🧴', 'Plástico misto': '🧃', 'Vidro': '🍾', 'Metal': '🥫', 'Papel branco': '📄' };

    const novoId = 'LT-' + String(100 + LOTES.length).padStart(3, '0');
    const novoLote = {
      id: novoId, material, icon: icons[material] || '♻️', kg: peso,
      resp, tipo: 'Catador', stage: 0, atualizado: 'agora mesmo', lat, lng,
    };
    LOTES.unshift(novoLote);
    saveLotes();
    loteVisibleCount = Math.max(loteVisibleCount, LOTE_PAGE_SIZE);
    renderFilters();
    renderLotes();
    renderPontuacao();
    renderImpacto();

    e.target.reset();
    document.getElementById('c-resp').value = resp;
    document.getElementById('geo-status').textContent = 'Nenhuma localização capturada ainda.';

    openQrModal(novoLote);
    return false;
  }

  // ---------------- QR code (RF03) ----------------
  function pickQrTypeNumber(len) {
    if (len < 40) return 4;
    if (len < 80) return 6;
    if (len < 130) return 9;
    if (len < 200) return 13;
    return 20;
  }

  function openQrModal(lote) {
    document.getElementById('qr-lote-id').textContent = lote.id;
    const payload = JSON.stringify({
      lote: lote.id, material: lote.material, kg: lote.kg,
      responsavel: lote.resp, lat: lote.lat, lng: lote.lng
    });
    const renderEl = document.getElementById('qr-render');
    renderEl.innerHTML = '';
    let rendered = false;
    if (typeof qrcode === 'function') {
      try {
        const qr = qrcode(pickQrTypeNumber(payload.length), 'M');
        qr.addData(payload, 'Byte');
        qr.make();
        renderEl.innerHTML = qr.createImgTag(5, 6);
        rendered = true;
      } catch (err) {
        rendered = false;
      }
    }
    if (!rendered) {
      renderEl.innerHTML = '<div class="qr-fallback mono">' + payload + '</div>';
    }
    document.getElementById('qr-info').innerHTML =
      '<div><b>Material:</b> ' + lote.material + ' · ' + lote.kg + ' kg</div>' +
      '<div><b>Responsável:</b> ' + lote.resp + '</div>' +
      '<div><b>Local:</b> ' + (lote.lat && lote.lng ? lote.lat + ', ' + lote.lng : 'não informado') + '</div>';
    document.getElementById('qr-modal').classList.add('show');
  }
  function closeQrModal() {
    document.getElementById('qr-modal').classList.remove('show');
  }
  function showLoteQr(id) {
    const lote = LOTES.find(l => l.id === id);
    if (lote) openQrModal(lote);
  }

  // ---------------- Rastreamento (RF04) ----------------
  function renderFilters() {
    const materiais = ['todos', ...new Set(LOTES.map(l => l.material))];
    const wrap = document.getElementById('lote-filters');
    wrap.innerHTML = materiais.map(m =>
      '<button class="chip ' + (m === currentFilter ? 'active' : '') + '" onclick="setFilter(\'' + m + '\')">' + (m === 'todos' ? 'Todos os lotes' : m) + '</button>'
    ).join('');
  }

  function setFilter(m) {
    currentFilter = m;
    loteVisibleCount = LOTE_PAGE_SIZE;
    renderFilters();
    renderLotes();
  }

  function loadMoreLotes() {
    loteVisibleCount += LOTE_PAGE_SIZE;
    renderLotes();
  }

  function renderLotes() {
    const full = currentFilter === 'todos' ? LOTES : LOTES.filter(l => l.material === currentFilter);
    const list = full.slice(0, loteVisibleCount);
    const wrap = document.getElementById('lote-list');
    wrap.innerHTML = list.map(l => {
      const stagesHtml = STAGES.map((s, i) => {
        let cls = '';
        if (i < l.stage) cls = 'done';
        else if (i === l.stage) cls = 'current';
        return '<div class="stage ' + cls + '"><div class="bar"></div><div class="pt">' + (i < l.stage ? '✓' : i + 1) + '</div><div class="lbl">' + s + '</div></div>';
      }).join('');
      return (
        '<div class="card lote-card">' +
          '<div class="lote-top">' +
            '<div>' +
              '<div class="lote-id">' + l.id + '</div>' +
              '<div class="lote-title">' + l.icon + ' ' + l.material + ' · ' + l.kg + ' kg</div>' +
              '<div class="lote-meta">Responsável: ' + l.resp + ' (' + l.tipo + ')</div>' +
            '</div>' +
            '<div class="lote-badges">' +
              '<button class="btn-qr" onclick="showLoteQr(\'' + l.id + '\')">▦ QR code</button>' +
              '<span class="lote-tag">' + STAGES[l.stage] + '</span>' +
            '</div>' +
          '</div>' +
          '<div class="stages">' + stagesHtml + '</div>' +
          '<div class="lote-foot"><span>Atualizado <b>' + l.atualizado + '</b></span>' +
          '<span class="geo-tag">📍 ' + (l.lat && l.lng ? l.lat + ', ' + l.lng : 'local não informado') + '</span></div>' +
        '</div>'
      );
    }).join('') || '<p style="color:var(--ink-soft); font-size:14px;">Nenhum lote encontrado para este material.</p>';

    document.getElementById('lote-loadmore-wrap').style.display = (loteVisibleCount < full.length) ? 'flex' : 'none';
  }

  // ---------------- Marketplace (RF06) ----------------
  function loadMoreCreditos() {
    mkVisibleCount += MK_PAGE_SIZE;
    renderMarketplace();
  }

  function renderMarketplace() {
    const list = CREDITOS_DEFAULT.slice(0, mkVisibleCount);
    const wrap = document.getElementById('mk-grid');
    wrap.innerHTML = list.map((c, idx) =>
      '<div class="card mk-card">' +
        '<div class="mk-icon">' + c.icon + '</div>' +
        '<div class="mk-mat">' + c.material + '</div>' +
        '<div class="mk-coop">Origem: ' + c.origem + '</div>' +
        '<div class="mk-stats"><div><b>' + c.kg + ' kg</b><span>reciclado</span></div><div><b>' + c.credito + '</b><span>créditos</span></div></div>' +
        '<button class="btn-mk" id="mk-btn-' + idx + '" onclick="requestCredit(' + idx + ')">Solicitar crédito</button>' +
      '</div>'
    ).join('');
    document.getElementById('mk-loadmore-wrap').style.display = (mkVisibleCount < CREDITOS_DEFAULT.length) ? 'flex' : 'none';
  }

  function requestCredit(idx) {
    const btn = document.getElementById('mk-btn-' + idx);
    btn.textContent = 'Solicitação enviada ✓';
    btn.classList.add('requested');
    btn.disabled = true;
  }

  // ---------------- Pontuação e recompensas (RF08) ----------------
  const LEVELS = [
    { nome: 'Nível Semente', min: 0 },
    { nome: 'Nível Broto', min: 200 },
    { nome: 'Nível Raiz Forte', min: 500 },
    { nome: 'Nível Guardião Verde', min: 1000 },
  ];

  function pontosPorResponsavel() {
    const mapa = {};
    LOTES.forEach(l => { mapa[l.resp] = (mapa[l.resp] || 0) + l.kg * 10; });
    return mapa;
  }

  function renderPontuacao() {
    const mapa = pontosPorResponsavel();
    const meusPontosBrutos = mapa[currentUserName] || 0;
    const meuKg = LOTES.filter(l => l.resp === currentUserName).reduce((a, l) => a + l.kg, 0);
    const meusPontos = Math.max(0, meusPontosBrutos - redeemedTotal);

    document.getElementById('my-points').textContent = meusPontos + ' pts';
    document.getElementById('my-kg').textContent = meuKg + ' kg';

    let nivelAtual = LEVELS[0], proximo = LEVELS[1];
    for (let i = 0; i < LEVELS.length; i++) {
      if (meusPontos >= LEVELS[i].min) { nivelAtual = LEVELS[i]; proximo = LEVELS[i + 1] || null; }
    }
    document.getElementById('level-name').textContent = nivelAtual.nome;
    if (proximo) {
      const pct = ((meusPontos - nivelAtual.min) / (proximo.min - nivelAtual.min)) * 100;
      document.getElementById('level-fill').style.width = Math.min(100, Math.max(0, pct)) + '%';
      document.getElementById('level-next').textContent = 'faltam ' + Math.max(0, proximo.min - meusPontos) + ' pts para ' + proximo.nome;
    } else {
      document.getElementById('level-fill').style.width = '100%';
      document.getElementById('level-next').textContent = 'nível máximo atingido';
    }

    const ranking = Object.entries(mapa)
      .map(([nome, pts]) => ({ nome, pts, tipo: (LOTES.find(l => l.resp === nome) || {}).tipo || '—' }))
      .sort((a, b) => b.pts - a.pts);

    const rows = ranking.map((r, i) =>
      '<tr class="' + (r.nome === currentUserName ? 'me' : '') + '">' +
        '<td class="pos">' + (i + 1) + 'º</td>' +
        '<td>' + r.nome + (r.nome === currentUserName ? ' (você)' : '') + '</td>' +
        '<td>' + r.tipo + '</td>' +
        '<td class="pts-pill">' + r.pts + ' pts</td>' +
      '</tr>'
    ).join('');
    document.getElementById('rank-table').innerHTML =
      '<tr><th>#</th><th>Nome</th><th>Perfil</th><th>Pontos</th></tr>' + rows;

    document.getElementById('reward-grid').innerHTML = REWARDS.map((r, idx) => {
      const disabled = meusPontos < r.custo;
      return (
        '<div class="card reward-card">' +
          '<div class="ic">' + r.icon + '</div>' +
          '<div class="rn">' + r.nome + '</div>' +
          '<div class="rc">' + r.custo + ' pts</div>' +
          '<button class="btn-redeem" ' + (disabled ? 'disabled' : '') + ' onclick="resgatar(' + idx + ')">Resgatar</button>' +
        '</div>'
      );
    }).join('');
  }

  function resgatar(idx) {
    const custo = REWARDS[idx].custo;
    redeemedTotal += custo;
    saveRedeemed();
    renderPontuacao();
  }

  // ---------------- Impacto ambiental (RF07) ----------------
  function renderImpacto() {
    const totalKg = LOTES.reduce((a, l) => a + l.kg, 0);
    const co2 = Math.round(totalKg * 1.8);
    const stats = [
      { n: totalKg + ' kg', lbl: 'Material rastreado' },
      { n: LOTES.length, lbl: 'Lotes com passaporte digital' },
      { n: co2 + ' kg', lbl: 'CO₂ evitado (estimado)' },
      { n: new Set(LOTES.map(l => l.resp)).size, lbl: 'Catadores e cooperativas ativos' },
    ];
    document.getElementById('impact-stats').innerHTML = stats.map(s =>
      '<div class="card stat-card"><div class="n">' + s.n + '</div><div class="lbl">' + s.lbl + '</div></div>'
    ).join('');

    const grupos = {};
    LOTES.forEach(l => {
      const chave = l.material.startsWith('Papel') ? 'Papel/papelão' : l.material.startsWith('Plástico') ? 'Plástico' : l.material;
      grupos[chave] = (grupos[chave] || 0) + l.kg;
    });
    const entradas = Object.entries(grupos).sort((a, b) => b[1] - a[1]);
    const max = Math.max(...entradas.map(e => e[1]), 1);
    document.getElementById('impact-bars').innerHTML = entradas.map(([label, kg]) =>
      '<div class="bar-row"><div class="bl">' + label + '</div><div class="bar-track"><div class="bar-fill" style="width:' + (kg / max * 100).toFixed(0) + '%"></div></div><div class="bv">' + kg + ' kg</div></div>'
    ).join('');
  }

  // ---------------- Init ----------------
  loadState();
  updateOnlineStatus();
  renderFilters();
  renderLotes();
  renderMarketplace();
  renderImpacto();
</script>
</body>
</html>
